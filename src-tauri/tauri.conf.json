{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TARDIS v1",
  "version": "0.1.0",
  "identifier": "com.tardis.v1.shell",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "TARDIS v1",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}

